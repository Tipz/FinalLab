@page "/"
<PageTitle>Вместе в путь — план поездки</PageTitle>
<a class="skip-link" href="#main">К содержимому</a>
<div class="shell">
    <header><a href="./" class="brand" aria-label="Вместе в путь, главная">вместе<span> / </span>в путь</a><span class="header-note">Семейный планировщик<br />Данные введены вручную</span><MudButton OnClick="Logout" Variant="MudBlazor.Variant.Text">Выйти</MudButton></header>
    <aside class="sidebar" aria-label="Разделы"><div class="eyebrow">Мой план</div><a href="#comparison">Сравнение</a><a href="#options">Варианты · @(Current?.Variants.Count ?? 0)</a><a href="#help">О приложении</a><p class="note">Важные детали.<br />Обдуманный выбор.<br />Всё в одном месте.</p></aside>
    <main id="main">
        <section class="intro"><div class="eyebrow">План поездки</div><h1 tabindex="-1">Все варианты.<br />Все расходы.</h1><p>Сравните направления и жильё по бюджету, дороге и семейным удобствам.</p></section>
        @if (loading)
        { <div class="panel empty" role="status"><MudProgressCircular Indeterminate Color="Color.Primary" Size="Size.Medium" /><p>Загружаем поездки…</p></div> }
        else if (readFailed)
        { <div class="panel empty"><MudAlert Severity="Severity.Error">Не удалось прочитать данные. Хранилище недоступно, повреждено или имеет несовместимую версию. Исходные данные не изменены.</MudAlert><MudButton OnClick="Load" Color="Color.Primary">Повторить</MudButton></div> }
        else
        {
            @if (legacyAvailable) { <MudAlert Severity="Severity.Info">Найдены поездки из локальной версии ДЗ № 4. Они не отправлены на сервер.<MudButton OnClick="ImportLegacy" Disabled="busy">Импортировать</MudButton></MudAlert> }
            @if (legacyReadFailed) { <MudAlert Severity="Severity.Warning">Локальное хранилище ДЗ № 4 не удалось прочитать. Оно не очищено и не изменено.</MudAlert> }
            <div class="feedback" role="status" aria-live="polite">@(busy ? "Сохраняем…" : success)</div>
            @if (error is not null && editor is null) { @StorageError }
            @if (Current is not null)
            {
                <fieldset class="workspace-fields" disabled="@busy">
                <section class="trip-toolbar" aria-label="Параметры поездки">
                    <div class="trip-switch"><label for="trip-select">Моя поездка</label><select id="trip-select" value="@currentId" @onchange="SwitchTrip" disabled="@busy">@foreach (var t in data.Trips) { <option value="@t.Id">@t.Name</option> }</select></div>
                    <div class="actions"><MudButton OnClick="EditTrip" Color="Color.Primary" Disabled="busy">Параметры поездки</MudButton><MudButton OnClick="NewTrip" Color="Color.Primary" Variant="MudBlazor.Variant.Outlined" Disabled="busy">Новая поездка</MudButton>@if (!HasExample) { <MudButton OnClick="AddExample" Color="Color.Secondary" Variant="MudBlazor.Variant.Text" Disabled="busy">Добавить пример</MudButton> }</div>
                </section>
                <div class="trip-meta"><span>@Current.StartDate.ToString("dd.MM.yyyy") — @Current.EndDate.ToString("dd.MM.yyyy")</span><span>Ночей: @Current.Nights</span><span>Взрослых: @Current.Adults · детей: @Current.ChildAges.Length</span><span>Возраст детей: @string.Join(", ", Current.ChildAges)</span></div>
                <p class="trip-budget-settings">Лимит бюджета: @(Current.BudgetLimitKopecks is long limit ? Budget.Money(limit) : "не задан") · Резерв: @Current.ReservePercent%</p>
                <Comparison @key="comparisonKey" Trip="Current" Busy="busy" ToggleCriterion="ToggleCriterion" AddVariant="NewVariant" />
                <section id="options" aria-labelledby="options-title">
                    <div class="section-head"><div><div class="eyebrow">Собираем идеи</div><h2 id="options-title">Ваши варианты <span class="count">@Current.Variants.Count</span></h2></div><MudButton OnClick="NewVariant" Color="Color.Primary" Variant="MudBlazor.Variant.Filled" Disabled="busy">Добавить вариант</MudButton></div>
                    @if (Current.Variants.Count == 0) { <div class="panel empty"><h3>Пока нет вариантов</h3><p>Добавьте найденное жильё и направление. Расходы и удобства можно уточнить позже.</p></div> }
                    else { <div class="cards">@foreach (var v in Current.Variants.OrderBy(v => v.CreatedAt)) { <VariantCard @key="(v.Id, comparisonKey)" Variant="v" Selected="Current.SelectedVariantIds.Contains(v.Id)" Busy="busy" BudgetLimitKopecks="Current.BudgetLimitKopecks" ReservePercent="Current.ReservePercent" SelectedCriteria="Current.SelectedCriteria" Clarify="ClarifyVariant" Toggle="ToggleVariant" Edit="EditVariant" Delete="DeleteVariant" /> }</div> }
                </section>
                </fieldset>
            }
            else
            { <section class="panel empty first-trip"><div class="empty-symbol" aria-hidden="true">＋</div><h2>Создайте первую поездку</h2><p>Задайте даты и состав семьи, затем добавьте варианты для сравнения.</p><MudButton OnClick="NewTrip" Variant="MudBlazor.Variant.Filled" Color="Color.Primary">Создать поездку</MudButton></section> }
        }
        <footer id="help"><strong>Планируйте вместе, выбирайте сами.</strong><p>@Catalog.LocalNotice.</p><details><summary>Как пользоваться</summary><p>Создайте поездку, добавьте предложения, заполните расходы. Отметьте «Сравнить» у двух или более карточек и выберите критерии. Все суммы вводятся в рублях за семью за весь период. Цены не обновляются автоматически.</p><p>Поездки доступны после входа в вашу учётную запись, в том числе с другого устройства.</p></details></footer>
    </main>
</div>
@if (editor == "trip")
{
    <TripEditor Original="editingTrip" Busy="busy" OnSave="SaveTrip" OnClose="CloseEditor"><ErrorContent>@StorageError</ErrorContent></TripEditor>
}
@if (editor == "variant")
{
    <VariantEditor Original="editingVariant" Busy="busy" BudgetLimitKopecks="Current?.BudgetLimitKopecks" ReservePercent="@(Current?.ReservePercent ?? 0)" InitialFocusField="@initialFocusField" OnSave="SaveVariant" OnClose="CloseEditor"><ErrorContent>@StorageError</ErrorContent></VariantEditor>
}
@code {
    private RenderFragment StorageError => @<div>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error">@error</MudAlert>
            @if (conflict) { <MudButton OnClick="ReloadCurrent" Color="Color.Primary" Disabled="busy">Загрузить актуальные данные</MudButton> }
            else if (retry is not null) { <MudButton OnClick="Retry" Color="Color.Primary" Disabled="busy">Повторить</MudButton> }
        }
    </div>;
}
